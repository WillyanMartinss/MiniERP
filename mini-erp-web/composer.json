{
    "name": "minierp/mini-erp-web",
    "description": "Mini ERP multi-tenant com fundação fiscal NF-e/NFC-e.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "ext-soap": "*",
        "ext-zlib": "*",
        "nfephp-org/sped-cte": "^5.0",
        "nfephp-org/sped-da": "^1.1",
        "nfephp-org/sped-nfe": "^5.2.8"
    },
    "autoload": {
        "psr-4": {
            "MiniErp\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
